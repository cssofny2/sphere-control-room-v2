{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/technician.ts": {
      "maxDuration": 60
    },
    "api/lookup.ts": {
      "maxDuration": 30
    },
    "api/email.ts": {
      "maxDuration": 30
    },
    "api/tts.ts": {
      "maxDuration": 20
    }
  },
  "redirects": [
    {
      "source": "/(overview|dashboard|chamber|copilot|protocol|timeline|spatial|vna|ldv|scope|clock|runs|insights|notebook|training|challenges|faults|learn|settings)",
      "destination": "/#/$1",
      "permanent": false
    }
  ]
}
